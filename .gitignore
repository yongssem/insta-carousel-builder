node_modules/
.env
.env.*.local
# output/ 은 PNG·MP4 같은 생성물이라 추적하지 않는다.
# 다만 원고(.md)는 손으로 쓴 결과물이므로 반드시 추적한다.
# ⚠️ 'output/' 로만 막으면 하위 .md 를 되살릴 수 없다 (부모 디렉터리가 제외되면
#    그 안의 파일은 !패턴으로 복구 불가). 그래서 output/* 단계로 쪼갠다.
output/*
!output/.keep
!output/*/
output/*/*
!output/*/*.md
*.log
.DS_Store
Thumbs.db
.claude/settings.local.json
.venv/
__pycache__/
*.pyc
